config_version=5

[application]

config/name="Ashcrown"
config/description="Mobile AFK open-world action RPG"
config/version="0.1.0-phase1"
run/main_scene="res://Main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://Core/EventBus.gd"
SaveManager="*res://Save/SaveManager.gd"

[display]

